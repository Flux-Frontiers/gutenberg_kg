{
  "mcpServers": {
    "gutenkg": {
      "command": "/Users/egs/repos/gutenberg_kg/.venv/bin/gutenkg-mcp",
      "env": {
        "GUTENKG_IMAGE_MODEL": "mlx-community/flux2-klein-4b-4bit",
        "GUTENKG_IMAGE_STEPS": "4"
      }
    },
    "paperbanana": {
      "command": "/Users/egs/repos/gutenberg_kg/.venv/bin/paperbanana-mcp",
      "env": {
        "VLM_PROVIDER": "openai_local",
        "VLM_MODEL": "Qwen3-30B-A3B-Instruct-2507-MLX-4bit",
        "OPENAI_LOCAL_BASE_URL": "http://localhost:8080/v1",
        "OPENAI_LOCAL_JSON_MODE": "false",
        "IMAGE_PROVIDER": "openai_imagen",
        "IMAGE_MODEL": "flux2-klein-4b",
        "OPENAI_BASE_URL": "http://localhost:8090/v1",
        "OPENAI_API_KEY": "not-needed"
      }
    },
    "pycodekg": {
      "command": "/Users/egs/repos/gutenberg_kg/.venv/bin/pycodekg-mcp",
      "args": ["--repo", "/Users/egs/repos/gutenberg_kg"]
    },
    "dockg": {
      "command": "/Users/egs/repos/gutenberg_kg/.venv/bin/dockg",
      "args": ["mcp", "--repo", "/Users/egs/repos/gutenberg_kg"]
    }
  }
}
