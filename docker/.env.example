# Copy to docker/.env and fill in as needed.
# All variables are optional — defaults work for a pure local setup.
# Synthesis is OFF unless VLLM_ENDPOINT_URL points at a running LLM server.

# Optional: require callers to include {"secret": "<value>"} in every request
HANDLER_SECRET=

# ---------------------------------------------------------------------------
# Synthesis backend — any OpenAI-compatible /v1 endpoint works.
# ---------------------------------------------------------------------------
# Recommended on Apple Silicon: oMLX (https://omlx.ai) — fast, multi-model,
# OpenAI-compatible. Start it on port 8080 (8000 is taken by the worker):
#
#     make serve-llm
#
# The worker reaches the host from inside Docker via host.docker.internal.
# VLLM_API_KEY must be your oMLX API key (from ~/.omlx/settings.json → auth.api_key).
VLLM_ENDPOINT_URL=http://host.docker.internal:8080/v1
VLLM_MODEL=Qwen3-4B-Instruct-2507-MLX-8bit
VLLM_API_KEY=sk-your-omlx-api-key

# ---------------------------------------------------------------------------
# Ollama backend (https://ollama.com) — cross-platform, no API key needed.
# The chat UI can switch to this backend via the Provider dropdown at runtime.
# Override the endpoint here if Ollama runs on a non-default port.
OLLAMA_ENDPOINT=http://host.docker.internal:11434/v1

# ---------------------------------------------------------------------------
# OpenAI backend — required if you select OpenAI in the Provider dropdown.
OPENAI_API_KEY=

# ---------------------------------------------------------------------------
# Image generation — base URL of a running mflux-serve instance on the host.
# Start it with:  make image-server   (uses isolated .venv-image)
# Leave blank to disable image rendering in the chat UI.
# Note: docker-compose maps this to IMAGE_ENDPOINT for compatibility.
# ---------------------------------------------------------------------------
GUTENKG_IMAGE_ENDPOINT=http://host.docker.internal:8090
IMAGE_STEPS=4
