# docker/.env.example — copy to docker/.env and fill in values
#
# HANDLER_SECRET: optional shared secret; requests must include {"secret": "<value>"}
# VLLM_ENDPOINT_URL: OpenAI-compatible base URL (oMLX default: http://host.docker.internal:8080)
# VLLM_MODEL: model ID served by the endpoint
# VLLM_API_KEY: bearer token (leave blank for Ollama)

HANDLER_SECRET=

VLLM_ENDPOINT_URL=http://host.docker.internal:8080
VLLM_MODEL=Qwen3-8B-MLX-4bit
VLLM_API_KEY=
