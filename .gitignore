# Ignore .claude contents except shared project files: skills and
# settings.json (pre-push ruff hook). Must be dir/* (not dir/) so the
# negations below can re-include — git can't reach into a fully
# ignored directory.
.claude/*
!.claude/skills/
!.claude/settings.json
.venv**
.vscode

# Swift / SwiftPM (app/)
.build/
.swiftpm/
DerivedData/
xcuserdata/

# XcodeGen output -- app/ios/project.yml is the source of truth; both of
# these are regenerated by `xcodegen generate` and must not be hand-edited.
app/ios/KnowledgePress.xcodeproj/
app/ios/Info.plist

# pdoc output — built in CI (docs.yml), deployed to GitHub Pages
site/

# === KG generated artifacts (normalized across the fleet) ===
# Databases, vector indexes and model caches are transient and
# reproducible. snapshots/ is TRACKED and must never be ignored --
# never use a bare `**/.<ns>/` pattern here, it swallows snapshots too.

**/.pycodekg/lancedb/
**/.pycodekg/lancedb-*
**/.pycodekg/*.sqlite
**/.pycodekg/*.sqlite-shm
**/.pycodekg/*.sqlite-wal
**/.pycodekg/*.db
**/.pycodekg/models

**/.dockg/*.sqlite
**/.dockg/*.sqlite-shm
**/.dockg/*.sqlite-wal
**/.dockg/*.db
**/.dockg/models
**/.dockg/embeddings.json

# Consolidated build output from `gutenkg build-corpus` -- multi-GB and fully
# reproducible. The rules above only caught bundles/*/.dockg/*.sqlite by
# coincidence, so catalog.json (and anything else a future bundle format adds)
# stayed committable; build_corpus.py's docstring already claimed this directory
# was ignored, which it was not. Ignore the whole tree, as intended.
bundles/

# AgentKG local store -- nothing under it is ever tracked
**/.agentkg/

**/.diarykg/*.sqlite
**/.diarykg/*.sqlite-shm
**/.diarykg/*.sqlite-wal
**/.diarykg/*.db
**/.diarykg/models
**/.diarykg/corpus

# Ingest reports -- one is written per real `gutenkg ingest` run, so routine
# partial rebuilds would otherwise pile up in the diff. They are good
# provenance (host, flags, embedder, per-book timings), so keep the ones worth
# keeping deliberately:  git add -f reports/ingest_<date>.md
reports/ingest_*.md

# PyCodeKG code-health reports -- regenerable in seconds from the KG
# (`pycodekg analyze .`), and they describe code that git already records, so
# tracking dated snapshots is churn. The experiment results beside them
# (similar_to_* sweeps, embedder_benchmark_*, front_matter_assessment) are NOT
# regenerable and stay tracked -- they are the evidence behind decisions the
# changelog asserts.
analysis/gutenberg_kg_analysis_*.md

# Agent scratch dirs (Claude Code / Codex)
.agents/
.codex/

renders/*

# MCP server config -- machine-specific, contains absolute paths
.mcp.json
.mcp.json.sav
# === end KG generated artifacts ===
